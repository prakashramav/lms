# ==========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================
APP_VERSION=1.0.0
NODE_ENV=production
PORT=5000

# Production Domains (Fully qualified with HTTPS)
STUDENT_APP_URL=https://student.example.com
INSTRUCTOR_APP_URL=https://instructor.example.com
ADMIN_APP_URL=https://admin.example.com
API_URL=https://api.example.com
CORS_ORIGIN=https://student.example.com,https://instructor.example.com,https://admin.example.com

# Production Database (Replica set with SSL and connection pooling)
MONGODB_URI=mongodb+srv://prod_app_user:<DB_PASSWORD>@prod-cluster.mongodb.net/edtech_production?retryWrites=true&w=majority
REDIS_URL=rediss://default:<REDIS_PASSWORD>@prod-redis.cache.example.com:6379

# Production Security & JWT (Rotate regularly, cryptographically secure min 64 hex chars)
JWT_SECRET=<PRODUCTION_RANDOM_SECRET_KEY_MIN_32_CHARS>
JWT_REFRESH_SECRET=<PRODUCTION_RANDOM_REFRESH_SECRET_KEY_MIN_32_CHARS>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=.example.com

# AI Services
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=<PRODUCTION_GEMINI_API_KEY>
OPENAI_API_KEY=

# File Storage
CLOUDINARY_CLOUD_NAME=<PRODUCTION_CLOUDINARY_NAME>
CLOUDINARY_API_KEY=<PRODUCTION_CLOUDINARY_KEY>
CLOUDINARY_API_SECRET=<PRODUCTION_CLOUDINARY_SECRET>

# Code Execution Sandbox
JUDGE0_API_URL=https://judge0.example.com
JUDGE0_API_KEY=<PRODUCTION_JUDGE0_KEY>

# Frontend Production API Target
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
