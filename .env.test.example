# ==========================================
# TEST ENVIRONMENT CONFIGURATION (.env.test)
# ==========================================
APP_VERSION=1.0.0
NODE_ENV=test
PORT=5000

# App URLs
STUDENT_APP_URL=http://localhost:3000
INSTRUCTOR_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3002
API_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# MongoDB In-Memory Server is used dynamically by Jest
MONGODB_URI=mongodb://127.0.0.1:27017/edtech_platform_test
REDIS_URL=redis://127.0.0.1:6379

# Deterministic Test Secrets (Isolated from all live environments)
JWT_SECRET=ci_test_jwt_secret_32_characters_minimum_len
JWT_REFRESH_SECRET=ci_test_jwt_refresh_secret_32_chars_min
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=

# Isolated Test Mocks
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=test_mock_gemini_key
OPENAI_API_KEY=test_mock_openai_key

# Mock Storage & Runner
CLOUDINARY_CLOUD_NAME=test-mock-cloud
CLOUDINARY_API_KEY=test-mock-key
CLOUDINARY_API_SECRET=test-mock-secret
JUDGE0_API_URL=http://127.0.0.1:2358
JUDGE0_API_KEY=test-mock-judge-key

NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
