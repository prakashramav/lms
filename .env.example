# ==========================================
# BACKEND ENVIRONMENT VARIABLES
# ==========================================
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/edtech_platform

# Authentication
JWT_SECRET=super_secret_jwt_access_key_min_32_chars_long
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_min_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Comma separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# AI Services
OPENAI_API_KEY=
GEMINI_API_KEY=

# File Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379

# Code Execution Sandbox
JUDGE0_API_URL=
JUDGE0_API_KEY=

# Payment Gateways
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email
EMAIL_API_KEY=

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES
# ==========================================
# Student Application (runs on port 3000)
# Instructor Application (runs on port 3001)
# Admin Application (runs on port 3002)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
