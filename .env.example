# ==========================================
# PLATFORM RELEASE & CORE CONFIG
# ==========================================
APP_VERSION=1.0.0
NODE_ENV=development
PORT=5000

# ==========================================
# PRODUCTION DOMAINS & CORS
# ==========================================
# Development URLs:
STUDENT_APP_URL=http://localhost:3000
INSTRUCTOR_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3002
API_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Production Domain Examples (Replace with your actual domain):
# STUDENT_APP_URL=https://student.example.com
# INSTRUCTOR_APP_URL=https://instructor.example.com
# ADMIN_APP_URL=https://admin.example.com
# API_URL=https://api.example.com
# CORS_ORIGIN=https://student.example.com,https://instructor.example.com,https://admin.example.com

# ==========================================
# DATABASE & CACHE
# ==========================================
MONGODB_URI=mongodb://localhost:27017/edtech_platform
REDIS_URL=redis://localhost:6379

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
JWT_SECRET=super_secret_jwt_access_key_min_32_chars_long_change_in_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_min_32_chars_long_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=

# ==========================================
# AI SERVICES (gemini | openai | mock)
# ==========================================
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

# ==========================================
# FILE STORAGE (Cloudinary / Local)
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# CODE EXECUTION SANDBOX (Judge0)
# ==========================================
JUDGE0_API_URL=
JUDGE0_API_KEY=

# ==========================================
# PAYMENT & COMMUNICATIONS
# ==========================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
EMAIL_API_KEY=

# ==========================================
# FRONTEND PUBLIC CONFIG (Next.js)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# In Production: NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
