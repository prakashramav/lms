# ==========================================
# LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION (.env.local)
# ==========================================
APP_VERSION=1.0.0
NODE_ENV=development
PORT=5000

# Local App URLs
STUDENT_APP_URL=http://localhost:3000
INSTRUCTOR_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3002
API_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Local Database & Cache
MONGODB_URI=mongodb://localhost:27017/edtech_platform_dev
REDIS_URL=redis://localhost:6379

# Local Development Auth Secrets (Never use in production)
JWT_SECRET=local_dev_jwt_secret_min_32_characters_long_only
JWT_REFRESH_SECRET=local_dev_jwt_refresh_secret_min_32_chars_only
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=

# Mock AI Service for offline development
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

# Local File Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local / Mock Code Execution
JUDGE0_API_URL=
JUDGE0_API_KEY=

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
