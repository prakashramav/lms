# ==========================================
# STAGING ENVIRONMENT CONFIGURATION
# ==========================================
APP_VERSION=1.0.0
NODE_ENV=staging
PORT=5000

# Domains
STUDENT_APP_URL=https://staging-student.example.com
INSTRUCTOR_APP_URL=https://staging-instructor.example.com
ADMIN_APP_URL=https://staging-admin.example.com
API_URL=https://staging-api.example.com
CORS_ORIGIN=https://staging-student.example.com,https://staging-instructor.example.com,https://staging-admin.example.com

# Database (Separate staging instance)
MONGODB_URI=mongodb+srv://staging_user:staging_pass@cluster0.example.mongodb.net/edtech_staging?retryWrites=true&w=majority
REDIS_URL=redis://staging-redis.example.com:6379

# Security & JWT
JWT_SECRET=staging_only_jwt_secret_min_32_characters_long_key
JWT_REFRESH_SECRET=staging_only_jwt_refresh_secret_min_32_chars_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=.example.com

# Integrations
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=staging_gemini_key
CLOUDINARY_CLOUD_NAME=staging-cloud
CLOUDINARY_API_KEY=staging-key
CLOUDINARY_API_SECRET=staging-secret
JUDGE0_API_URL=https://staging-judge0.example.com
JUDGE0_API_KEY=staging-judge0-key

# Frontend
NEXT_PUBLIC_API_URL=https://staging-api.example.com/api/v1
